# ── MikCloud — variables d'environnement backend ──
# Copier en `.env` local si besoin (le mode par défaut sans ces variables
# reste le fichier JSON data/db.json, zéro configuration).

# Production (Render) : URL de connexion Neon PostgreSQL.
# Neon → Dashboard → ton projet → Connection string.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Secret de signature des JWT (en production : généré par Render).
# JWT_SECRET=change-me

# Compte administrateur de production (remplace le compte démo admin/admin123).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=un-mot-de-passe-fort
# ADMIN_NAME=Administrateur MikCloud
