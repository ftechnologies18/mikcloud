# mikcloud — variables du backend sur la VM Oracle.
# Copier vers /etc/mikcloud/mikcloud.env (chmod 640 root:mikcloud) et
# renseigner les VRAIES valeurs — JAMAIS de secret dans le repo.
# Référence complète des usages : docs/MIGRATION-ORACLE.md §3 et
# backend/internal (getEnv). Les valeurs de production actuelles vivent
# dans les variables d'environment du service Render (API Render
# GET /v1/services/{id}/env-vars) — la reprise se fait en une commande,
# cf. §3 du runbook.

# --- Réseau / process ---------------------------------------------------
PORT=4000
# URL publique du BACKEND. VIDE = dérivée du Host de la requête
# (comportement historique). Posée (ex. https://api.mikcloud.ftci.fr),
# elle prime partout : scripts agents, apiBase cuite des pages portail
# (le fingerprint N°210 re-déploie les pages à sa mise à jour), webhooks.
MIKCLOUD_BASE_URL=
# --- Base (Supabase — inchangée) ----------------------------------------
# Pooler TRANSACTION (port 6543) pour l'application.
DATABASE_URL=
# sslmode verify-full exige la CA privée installée par bootstrap.sh
# (backend/certs/supabase-prod-ca-2021.crt) — ne pas passer en sslmode
# moindre sans décision consignée.
MIKCLOUD_PG_SSLMODE=verify-full
NEON_KEEPALIVE=business

# --- Sécurité -----------------------------------------------------------
# Fatal si absent en production (base PG) : signature JWT + dérivation
# CREDENTIALS_KEY (chiffrement des identifiants RouterOS).
JWT_SECRET=
# Clé 64-hex dédiée (optionnelle — dérivée de JWT_SECRET par HKDF si vide).
CREDENTIALS_KEY=
# Bootstrap admin plateforme (requis uniquement sur une base vide).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
# Inscriptions plateforme (vide = ouvert ; REGISTER_KEY verrouille).
REGISTER_KEY=

# --- CORS / URLs publiques ----------------------------------------------
# Origines autorisées (CSV). Repris telles quelles de Render.
ALLOWED_ORIGIN=
# Origine du FRONTEND (liens /join, /wifi, e-mails, fingerprint portail).
APP_PUBLIC_URL=
# Webhook Telegram : URL backend (prime RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=

# --- Médias R2 (inchangé) ------------------------------------------------
R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_BUCKET=mikcloud-media
R2_PUBLIC_BASE=

# --- Paiements / notifications (repris de Render) -------------------------
WAVE_PAY_LINK=
WAVE_WEBHOOK_SECRET=
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
TELEGRAM_PLATFORM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- N°291 — WireGuard vendable : mini-service hôte wg-mini ---------------
# Le backend pilote wg-peer.sh via wg-mini (même VM, boucle locale — cf.
# deploy/oracle/wg-mini/README.md). WG_MINI_SECRET doit être IDENTIQUE à
# celui du /etc/mikcloud/wg-mini.env de l'unité systemd (64 hex, 600 root).
# WG_MINI_URL est optionnel (défaut http://127.0.0.1:4020 — port réservé).
WG_MINI_URL=http://127.0.0.1:4020
WG_MINI_SECRET=

# --- Limites --------------------------------------------------------------
RATE_API_PER_MIN=120
